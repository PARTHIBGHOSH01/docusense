# Used by Docker Compose. Change this before exposing the service.
POSTGRES_PASSWORD=change-me-for-local-use

# Backend settings for running FastAPI directly (SQLite default):
# DATABASE_URL=sqlite:///./data/docusense.db
# DATA_DIR=./data
# MAX_UPLOAD_MB=15
# CORS_ORIGINS=http://localhost:5173

# Optional for local use. Public deployments must enable auth and set strong values.
# AUTH_REQUIRED=true
# APP_USERNAME=your-login-name
# APP_PASSWORD=replace-with-a-long-random-password
